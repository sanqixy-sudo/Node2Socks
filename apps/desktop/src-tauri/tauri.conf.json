{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Node2Socks",
  "version": "0.1.1",
  "identifier": "com.node2socks.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Node2Socks",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "backgroundThrottling": "throttle"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["../../../sidecar/windows-x64/node2socks-mihomo"],
    "resources": ["../../../sidecar/LICENSES/MIHOMO_NOTICE.md"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
